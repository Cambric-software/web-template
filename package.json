{
  "name": "cambric-web-template",
  "version": "1.0.1",
  "private": true,
  "description": "Cambric local-first web template foundation.",
  "bin": {
    "cambric": "./bin/cambric.js"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "diagnose": "node scripts/doctor.js",
    "test": "node tests/cambric-core.test.js && node tests/basic.test.js",
    "test:browser": "playwright test",
    "build": "node scripts/build.js",
    "verify": "node scripts/verify.js",
    "dev": "node scripts/serve.js",
    "clean": "node scripts/build.js --clean",
    "cache": "node -e \"const { cambricCacheInfo } = require('./services/cache.js'); cambricCacheInfo().then((info) => console.log(JSON.stringify(info, null, 2))).catch((error) => { console.error(error.message); process.exit(1); });\"",
    "update": "node -e \"console.log('No forced remote updates are required for a local-first template.');\"",
    "version": "node -p \"require('./services/version.js').CAMBRIC_VERSION\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
