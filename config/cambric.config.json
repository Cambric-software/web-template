{
  "schemaVersion": 1,
  "environment": "development",
  "site": {
    "url": "https://example.com",
    "language": "en"
  },
  "product": {
    "id": "cambric-web-product",
    "name": "Cambric Website",
    "description": "Cambric local-first website template for accessible, privacy-aware product experiences.",
    "version": "1.0.1",
    "templateVersion": "1.0.0",
    "websiteTitle": "Cambric Website",
    "owner": "Cambric Software"
  },
  "cache": {
    "enabled": true,
    "prefix": "cambric-",
    "version": "cambric-web-v1",
    "maxEntries": 200,
    "ttlMs": 86400000
  },
  "features": {
    "offline": true,
    "cache": true,
    "ecosystem": true,
    "localization": true,
    "pwa": false,
    "extensions": false
  },
  "security": {
    "cspEnabled": false,
    "secretScanEnabled": true,
    "requireHttpsForSensitiveActions": false,
    "safeUrlPatterns": [
      "https://",
      "http://localhost",
      "blob:",
      "file://"
    ]
  },
  "localization": {
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "ar"],
    "rtlLanguages": ["ar"]
  },
  "update": {
    "enabled": true,
    "checkOnLoad": true,
    "cacheTtlMs": 86400000
  },
  "privacy": {
    "localFirst": true,
    "noTelemetry": true,
    "noServerRequired": true
  },
  "environmentOverrides": {}
}
